logging {
	level  = "info"
	format = "json"
}

// Discover only this Compose project; the name also follows `docker compose -p`.
discovery.docker "applications" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "5s"

	filter {
		name   = "label"
		values = ["com.docker.compose.project=" + sys.env("COMPOSE_PROJECT_NAME")]
	}
}

discovery.relabel "applications" {
	targets = discovery.docker.applications.targets

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "order-api|payment-worker"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}
}

// Docker's API already unwraps the logging-driver envelope; preserve the zap JSON.
// Read positions live under --storage.path, in the alloy-data volume.
loki.source.docker "applications" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.applications.output
	forward_to = [loki.process.applications.receiver]
}

loki.process "applications" {
	// IDs, paths, status codes and durations stay in the original JSON, not labels.
	stage.label_keep {
		values = ["service"]
	}

	forward_to = [loki.write.local.receiver]
}

loki.write "local" {
	endpoint {
		url                 = "http://loki:3100/loki/api/v1/push"
		max_backoff_period  = "5s"
		max_backoff_retries = 0
	}
}
