# Retain at least 30 days for the planned rolling 30-day SLO.
PROMETHEUS_RETENTION_TIME=35d

# Loki log retention; at least 24h, expressed in hours. Compactor deletes expired logs.
LOKI_RETENTION_PERIOD=168h
# Host Docker socket for Alloy. For rootless Docker use /run/user/<uid>/docker.sock.
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Local Grafana login, initialized only when grafana-data is empty.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Dependency timeout and simulated payment processing delay (Go duration format).
PAYMENT_TIMEOUT=5s
PROCESS_DELAY=20ms

# OTLP/HTTP base URL inside Compose; local Go runs default to http://127.0.0.1:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# Optional full traces URL overrides the base URL, including its /v1/traces path.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Export timeout in milliseconds. Signal-specific timeout overrides the generic one.
OTEL_EXPORTER_OTLP_TIMEOUT=1000
OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=
# Parent-based trace ID ratio sampling: 0 disables new root traces, 1 samples all.
OTEL_TRACES_SAMPLER_ARG=1.0
